# Sentry source-map upload (release builds only — NOT needed for `expo start`
# or dev builds). Obtain an auth token at
# https://sentry.io/orgredirect/organizations/:orgslug/settings/auth-tokens/
# with the `project:releases` + `org:read` scopes.
#
# In CI these come from the repository's GitHub Actions secrets. Locally, copy
# this file to `.env.local` and fill values only if you are producing a signed
# release build (`gradlew assembleRelease` via the scheduled-release workflow)
# and want source maps uploaded to Sentry.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# BLD-561: OpenAI key for `npm run generate:exercise-images`. Dev-only script
# (NOT used by the app at runtime). Required to populate the pilot pose
# manifest in `assets/exercise-illustrations/`. Never log or commit the value.
OPENAI_API_KEY=

# OpenRouter free-model e2e smoke-test key (local only; never commit a value).
OPENROUTER_TEST_API_KEY=

# Vision pipeline / regression-smoke trust anchor (BLD-959 / BLD-3039).
# `scripts/regression-smoke.sh` (invoked by `scripts/daily-audit.sh`) feeds a
# known-bad PNG into a vision model to verify the audit pipeline is still
# detecting visual regressions. At least one of these keys must be set in the
# daily audit environment. Anthropic is preferred; OpenAI is the fallback.
#
# WITHOUT either key: `regression-smoke.sh` exits 4 and `daily-audit.sh`
# aborts with a FATAL error (production default). Set
# AUDIT_ALLOW_NO_VISION_KEY=1 in the environment to instead run in
# SKIPPED/UNVERIFIED mode (sandbox/CI opt-in — the audit completes but trust
# status is marked UNVERIFIED, never PASS).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY is shared with the image-generation script above; a single
# entry covers both uses — the vision pipeline auto-detects it as fallback.

# Strava developer-dashboard internal API credentials, used by the
# `cablesnap--strava-oauth` skill scripts in
# `.claude/skills/cablesnap--strava-oauth/scripts/`. Required ONLY when
# inspecting / mutating the Strava app config (id 227474) — NOT used by the
# app at runtime, NOT needed for normal Strava OAuth (which uses the public
# client_id + Cloudflare Worker proxy).
#
# How to capture (rotates whenever you log out):
# 1. Log into https://www.strava.com/settings/api
# 2. DevTools → Network → trigger any XHR on the page
# 3. Copy `_strava4_session` from request Cookie header
# 4. Copy `x-csrf-token` from request headers
STRAVA_DASHBOARD_SESSION=
STRAVA_DASHBOARD_CSRF=
