{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".eslintrc.js",
    "app.config.ts"
  ],
  "exclude": [
    "node_modules",
    "workers/agent-relay",
    ".expo",
    "dist"
  ]
}
